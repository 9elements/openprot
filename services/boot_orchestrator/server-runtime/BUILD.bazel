load("@rules_rust//rust:defs.bzl", "rust_library")
load("//target/ast10x0:defs.bzl", "TARGET_COMPATIBLE_WITH")

# The single kernel-tagged crate: wraps boot_orchestrator_server and the pure
# openprot_orchestrator_sm state machine in the Pigweed WaitGroup loop, and
# performs the power-on provisioning bring-up. Verified on-target, not host.
rust_library(
    name = "boot_orchestrator_server_runtime",
    srcs = ["src/lib.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
    deps = [
        "//services/boot_orchestrator/api:boot_orchestrator_api",
        "//services/boot_orchestrator/server:boot_orchestrator_server",
        "//services/orchestrator/sm:orchestrator_sm",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@rust_crates//:heapless",
    ],
)
